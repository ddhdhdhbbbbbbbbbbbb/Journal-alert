{
  "project": {
    "name": "园艺文献日报",
    "timezone": "Asia/Shanghai"
  },
  "window": {
    "days": 3,
    "max_catchup_days": 30,
    "max_items_per_journal": 60,
    "workers": 6,
    "rss_timeout_seconds": 25,
    "api_timeout_seconds": 45,
    "retries": 2,
    "sources": {
      "rss": true,
      "openalex": true,
      "crossref": true
    }
  },
  "output": {
    "dir": "reports",
    "keep_days": 365,
    "max_entries": 10,
    "open_after_run": false,
    "write_json_snapshot": true,
    "source_status": "summary",
    "frontmatter": true,
    "cards": true,
    "cards_html": "docs/index.html"
  },
  "keywords": [
    {
      "label": "柑橘",
      "main": true,
      "weight": 3,
      "terms": [
        "",
        "citrus",
        "pomelo"
      ]
    },
    {
      "label": "嫁接",
      "main": true,
      "weight": 3,
      "terms": [
        "remote sensing",
        "graft",
        "grafting"
      ]
    },
    {
      "label": "接穗",
      "main": true,
      "weight": 3,
      "terms": [
        "scion"
      ]
    },
    {
      "label": "砧木",
      "main": true,
      "weight": 3,
      "terms": [
        "interstock",
        "rootstock"
      ]
    },
  ]
  "exclude_terms": [
    "retraction",
    "retracted",
    "correction",
    "corrigendum",
    "erratum",
    "author correction",
    "publisher correction",
    "editorial board",
    "in this issue",
    "issue information",
    "table of contents",
    "call for papers"
  ],
  "exclude_doi_prefixes": [
    "10.1038/d41586"
  ],
  "tiers": {
    "must_read": 12,
    "worth_reading": 6,
    "min_score": 3
  },
  "journals": [
    {
      "name": "Nature",
      "issn": "0028-0836",
      "rss": "https://www.nature.com/nature.rss",
      "enabled": true
    },
    {
      "name": "Science",
      "issn": "0036-8075",
      "rss": "https://www.science.org/action/showFeed?type=etoc&feed=rss&jc=science",
      "enabled": true
    },
    {
      "name": "Nature Communications",
      "issn": "2041-1723",
      "rss": "https://www.nature.com/ncomms.rss",
      "enabled": true
    },
    {
      "name": "Science Advances",
      "issn": "2375-2548",
      "rss": "https://www.science.org/action/showFeed?type=etoc&feed=rss&jc=sciadv",
      "enabled": true
    },
    {
      "name": "Cities",
      "issn": "0264-2751",
      "rss": "https://rss.sciencedirect.com/publication/science/02642751",
      "enabled": true
    },
    {
      "name": "ISPRS Journal of Photogrammetry and Remote Sensing",
      "issn": "0924-2716",
      "rss": "https://rss.sciencedirect.com/publication/science/09242716",
      "enabled": true
    },
    {
      "name": "International Journal of Geographical Information Science",
      "issn": "1365-8816",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Transactions in GIS",
      "issn": "1361-1682",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Environment and Planning B: Urban Analytics and City Science",
      "issn": "2399-8083",
      "rss": "",
      "enabled": true
    }
  ],
  "push": {
    "enabled": true,
    "skip_when_empty": true,
    "max_items": 6,
    "max_chars": 1800,
    "channels": {
      "serverchan": {
        "enabled": true,
        "sendkey": ""
      },
      "pushplus": {
        "enabled": true,
        "token": ""
      },
      "bark": {
        "enabled": false,
        "key": "",
        "server": "https://api.day.app",
        "sound": "bird"
      }
    }
  },
  "log": {
    "dir": "logs",
    "level": "INFO"
  }
}
